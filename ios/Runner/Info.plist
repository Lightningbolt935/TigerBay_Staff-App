<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ios/Runner/Info.plist — permission usage description strings.

  IMPORTANT: Flutter generates a base Info.plist the first time you run
  `flutter build ios` on macOS.  Merge the entries below into that generated
  file inside Xcode (open ios/Runner.xcworkspace → Runner target →
  Info tab, or edit the raw XML directly).

  All values are surfaced verbatim in system permission prompts, so keep them
  user-friendly, specific, and honest about why each permission is needed.
-->
<plist version="1.0">
<dict>

	<!-- ── Location ──────────────────────────────────────────────────────── -->

	<!--
	  "When In Use" is the minimum needed for foreground check-in/out.
	  geolocator's LocationAccuracy.high will automatically request precise
	  location on iOS 14+ — no additional code required.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We need your location to verify you are physically present at the Tigerbay branch to clock in or out.</string>

	<!--
	  "Always" is only required if you add background geofence monitoring
	  (e.g. automatic clock-out on leaving the venue).  Include now to avoid
	  a second App Store review round if that feature is added later.
	-->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>We need your location to verify your presence at the branch for attendance logging.</string>

	<!--
	  Legacy iOS 10 key — must accompany NSLocationAlwaysAndWhenInUseUsageDescription
	  on any build targeting iOS 10 devices, otherwise Always authorization silently
	  falls back to "When In Use" on those devices.
	-->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>We need your location to verify your presence at the branch for attendance logging.</string>

	<!-- ── Camera ────────────────────────────────────────────────────────── -->

	<!--
	  Used by mobile_scanner (QR loyalty code scanning) and image_picker
	  (capturing new photos for catalog items and rewards).
	-->
	<key>NSCameraUsageDescription</key>
	<string>We need access to your camera to scan member loyalty QR codes and to capture new photo previews for catalog items and rewards.</string>

	<!-- ── Photo Library ────────────────────────────────────────────────── -->

	<!--
	  Required by image_picker so managers can choose existing photos from
	  the gallery when editing catalog items or rewards.
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>We need access to your photo library to select dish and reward image previews for the catalog.</string>

	<!-- ── Microphone ───────────────────────────────────────────────────── -->

	<!--
	  App Store requires this key whenever the camera entitlement is declared,
	  even if audio recording is not actively used by the app.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>We need access to your microphone when capturing media content for catalog items.</string>

	<!-- ── Face ID / Biometrics ──────────────────────────────────────────── -->

	<!--
	  Required when local_auth uses Face ID.  Touch ID does not need a
	  separate key.  Without this key, the app will crash at the biometric
	  authentication call on Face ID devices.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>TigerBay uses Face ID to quickly verify device release authorization.</string>

</dict>
</plist>
